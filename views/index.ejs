<%- include('partials/header') %>

<section class="hero">
  <div class="container">
    <h1 class="hero-title">Унших номоо хайж олоорой</h1>
    <p class="hero-sub"><%= schoolName %>-ийн сурагч, багш нарт зориулсан цахим номын сан</p>
    <form id="search-form" class="search" method="get" action="/" role="search">
      <svg class="search-icon" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>
      <input type="search" name="q" value="<%= filters.q %>" placeholder="Номын нэр, зохиогч, түлхүүр үгээр хайх…" aria-label="Ном хайх" autocomplete="off">
      <% if (filters.category) { %><input type="hidden" name="category" value="<%= filters.category %>"><% } %>
      <button type="submit" class="btn btn-accent">Хайх</button>
    </form>
  </div>
</section>

<div class="container">
  <% if (categories.length) { %>
    <nav class="chips" aria-label="Ангилал">
      <a class="chip<%= !filters.category ? ' active' : '' %>" href="/<%= h.queryString({ q: filters.q, grade: filters.grade, sort: filters.sort === 'new' ? '' : filters.sort }) %>">Бүгд</a>
      <% for (const c of categories) { %>
        <a class="chip<%= filters.category === c.name ? ' active' : '' %>" href="/<%= h.queryString({ q: filters.q, grade: filters.grade, sort: filters.sort === 'new' ? '' : filters.sort, category: c.name }) %>"><%= c.name %> <span class="chip-count"><%= c.count %></span></a>
      <% } %>
    </nav>
  <% } %>

  <div class="toolbar">
    <p class="result-count">
      <% if (isFiltered) { %>
        <strong><%= total %></strong> ном олдлоо
        <% if (filters.q) { %> · “<%= filters.q %>”<% } %>
        <a class="clear-link" href="/">Шүүлтүүр арилгах</a>
      <% } else { %>
        Нийт <strong><%= total %></strong> ном
      <% } %>
    </p>
    <div class="filters">
      <label class="select-label">
        <span class="visually-hidden">Анги</span>
        <select name="grade" form="search-form" data-autosubmit>
          <option value="">Бүх анги</option>
          <% for (const g of h.GRADES) { %>
            <option value="<%= g %>"<%= filters.grade === g ? ' selected' : '' %>><%= h.gradeLabel(g) %></option>
          <% } %>
        </select>
      </label>
      <label class="select-label">
        <span class="visually-hidden">Эрэмбэлэх</span>
        <select name="sort" form="search-form" data-autosubmit>
          <% for (const [value, label] of Object.entries(h.SORT_LABELS)) { %>
            <option value="<%= value %>"<%= filters.sort === value ? ' selected' : '' %>><%= label %></option>
          <% } %>
        </select>
      </label>
      <noscript><button type="submit" form="search-form" class="btn btn-outline btn-sm">Шүүх</button></noscript>
    </div>
  </div>

  <% if (books.length) { %>
    <div class="book-grid">
      <% for (const book of books) { %>
        <%- include('partials/book-card', { book }) %>
      <% } %>
    </div>
    <%- include('partials/pagination', { basePath: '/', params: { ...filters, sort: filters.sort === 'new' ? '' : filters.sort } }) %>
  <% } else { %>
    <div class="empty">
      <svg viewBox="0 0 24 24" width="48" height="48" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M2 4.5A1.5 1.5 0 0 1 3.5 3H9a3 3 0 0 1 3 3v15a2.5 2.5 0 0 0-2.5-2.5H3.5A1.5 1.5 0 0 1 2 17Z"/><path d="M22 4.5A1.5 1.5 0 0 0 20.5 3H15a3 3 0 0 0-3 3v15a2.5 2.5 0 0 1 2.5-2.5h6a1.5 1.5 0 0 0 1.5-1.5Z"/></svg>
      <% if (isFiltered) { %>
        <h2>Тохирох ном олдсонгүй</h2>
        <p>Өөр үгээр хайж үзнэ үү, эсвэл <a href="/">бүх номыг харах</a>.</p>
      <% } else { %>
        <h2>Одоогоор ном нэмэгдээгүй байна</h2>
        <% if (isAdmin) { %>
          <p><a class="btn btn-primary" href="/admin/books/new">+ Эхний номоо нэмэх</a></p>
        <% } else { %>
          <p>Удахгүй номууд нэмэгдэнэ.</p>
        <% } %>
      <% } %>
    </div>
  <% } %>
</div>

<%- include('partials/footer') %>
