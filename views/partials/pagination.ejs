<% if (totalPages > 1) { %>
  <nav class="pagination" aria-label="Хуудаслалт">
    <% if (page > 1) { %>
      <a class="page-link" href="<%= basePath %><%= h.queryString(params, { page: page - 1 }) %>" rel="prev">‹ Өмнөх</a>
    <% } %>
    <% for (const p of h.pageNumbers(page, totalPages)) { %>
      <% if (p === null) { %>
        <span class="page-gap">…</span>
      <% } else if (p === page) { %>
        <span class="page-link current" aria-current="page"><%= p %></span>
      <% } else { %>
        <a class="page-link" href="<%= basePath %><%= h.queryString(params, { page: p }) %>"><%= p %></a>
      <% } %>
    <% } %>
    <% if (page < totalPages) { %>
      <a class="page-link" href="<%= basePath %><%= h.queryString(params, { page: page + 1 }) %>" rel="next">Дараах ›</a>
    <% } %>
  </nav>
<% } %>
