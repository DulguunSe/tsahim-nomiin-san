<!doctype html>
<html lang="mn">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= title ? title + ' · ' : '' %>Цахим номын сан · <%= schoolName %></title>
  <meta name="description" content="<%= schoolName %> — сурагч, багш нарт зориулсан цахим номын сан">
  <link rel="icon" href="/static/favicon.svg" type="image/svg+xml">
  <link rel="stylesheet" href="/static/css/style.css">
  <script src="/static/js/app.js" defer></script>
</head>
<body>
  <a class="skip-link" href="#main">Үндсэн агуулга руу шилжих</a>
  <header class="site-header">
    <div class="container header-inner">
      <a class="brand" href="/">
        <span class="brand-logo" aria-hidden="true">
          <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M2 4.5A1.5 1.5 0 0 1 3.5 3H9a3 3 0 0 1 3 3v15a2.5 2.5 0 0 0-2.5-2.5H3.5A1.5 1.5 0 0 1 2 17Z"/><path d="M22 4.5A1.5 1.5 0 0 0 20.5 3H15a3 3 0 0 0-3 3v15a2.5 2.5 0 0 1 2.5-2.5h6a1.5 1.5 0 0 0 1.5-1.5Z"/></svg>
        </span>
        <span class="brand-text">
          <span class="brand-title">Цахим номын сан</span>
          <span class="brand-sub"><%= schoolName %></span>
        </span>
      </a>
      <nav class="nav" aria-label="Үндсэн цэс">
        <a href="/" class="nav-link<%= currentPath === '/' ? ' active' : '' %>">Номууд</a>
        <% if (isAdmin) { %>
          <a href="/admin" class="nav-link<%= currentPath === '/admin' ? ' active' : '' %>">Самбар</a>
          <form method="post" action="/admin/logout" class="inline-form">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <button type="submit" class="nav-link link-button">Гарах</button>
          </form>
          <a href="/admin/books/new" class="btn btn-primary btn-sm">+ Ном нэмэх</a>
        <% } else { %>
          <a href="/admin/login" class="nav-link<%= currentPath.startsWith('/admin') ? ' active' : '' %>">Админ</a>
        <% } %>
      </nav>
    </div>
  </header>
  <main id="main">
    <% if (flash) { %>
      <div class="container">
        <div class="alert alert-<%= flash.type %>" role="status"><%= flash.message %></div>
      </div>
    <% } %>
