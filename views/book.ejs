<%- include('partials/header') %>

<div class="container">
  <nav class="breadcrumb" aria-label="Байршил">
    <a href="/">Номууд</a>
    <% if (book.category) { %>
      <span aria-hidden="true">/</span>
      <a href="/?category=<%= encodeURIComponent(book.category) %>"><%= book.category %></a>
    <% } %>
    <span aria-hidden="true">/</span>
    <span aria-current="page"><%= book.title %></span>
  </nav>

  <article class="book-detail">
    <div class="book-detail-cover"><%- include('partials/cover', { book }) %></div>

    <div class="book-detail-info">
      <% if (book.category) { %>
        <a class="tag tag-primary" href="/?category=<%= encodeURIComponent(book.category) %>"><%= book.category %></a>
      <% } %>
      <h1 class="book-detail-title"><%= book.title %></h1>
      <% if (book.author) { %><p class="book-detail-author"><%= book.author %></p><% } %>

      <dl class="meta">
        <div><dt>Анги</dt><dd><%= h.gradeLabel(book.grade) %></dd></div>
        <% if (book.year) { %><div><dt>Хэвлэгдсэн он</dt><dd><%= book.year %></dd></div><% } %>
        <div><dt>Хэл</dt><dd><%= book.language %></dd></div>
        <% if (book.file_size) { %><div><dt>Хэмжээ</dt><dd><%= h.formatSize(book.file_size) %></dd></div><% } %>
        <div><dt>Үзсэн</dt><dd><%= h.formatNumber(book.views) %></dd></div>
        <div><dt>Татсан</dt><dd><%= h.formatNumber(book.downloads) %></dd></div>
      </dl>

      <div class="actions">
        <% if (book.file_name) { %>
          <a class="btn btn-primary btn-lg" href="/books/<%= book.id %>/file" target="_blank" rel="noopener" data-reader-open>
            <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7S2 12 2 12Z"/><circle cx="12" cy="12" r="3"/></svg>
            Онлайн унших
          </a>
          <a class="btn btn-outline btn-lg" href="/books/<%= book.id %>/download">
            <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3v12"/><path d="m7 10 5 5 5-5"/><path d="M5 21h14"/></svg>
            Татаж авах
          </a>
        <% } %>
        <% if (book.external_url) { %>
          <a class="btn <%= book.file_name ? 'btn-outline' : 'btn-primary' %> btn-lg" href="/books/<%= book.id %>/link" target="_blank" rel="noopener noreferrer">
            Холбоосоор нээх ↗
          </a>
        <% } %>
        <% if (isAdmin) { %>
          <a class="btn btn-ghost btn-lg" href="/admin/books/<%= book.id %>/edit">Засах</a>
        <% } %>
      </div>

      <% if (book.description) { %>
        <section class="description">
          <h2>Товч агуулга</h2>
          <p><%= book.description %></p>
        </section>
      <% } %>
    </div>
  </article>

  <% if (book.file_name) { %>
    <section id="reader" class="reader" hidden>
      <div class="reader-head">
        <h2>Онлайн унших</h2>
        <div class="reader-actions">
          <a href="/books/<%= book.id %>/file" target="_blank" rel="noopener">Шинэ цонхонд нээх ↗</a>
          <button type="button" class="link-button" data-reader-close>Хаах ✕</button>
        </div>
      </div>
      <iframe class="reader-frame" data-src="/books/<%= book.id %>/file" title="<%= book.title %>"></iframe>
      <p class="reader-note">Ном харагдахгүй байвал “Шинэ цонхонд нээх” эсвэл “Татаж авах” товчийг дарна уу.</p>
    </section>
  <% } %>

  <% if (related.length) { %>
    <section class="related">
      <h2 class="section-title">Ижил ангиллын номууд</h2>
      <div class="book-grid">
        <% for (const book of related) { %>
          <%- include('partials/book-card', { book }) %>
        <% } %>
      </div>
    </section>
  <% } %>
</div>

<%- include('partials/footer') %>
