# ---- Цахим номын сангийн тохиргоо ----
# Энэ файлыг ".env" нэрээр хуулаад утгуудыг өөрчилнө үү.

# Сургуулийн нэр (сайтын толгой хэсэгт харагдана)
SCHOOL_NAME=Манай сургууль

# Админ хэсэгт нэвтрэх нууц үг — ЗААВАЛ өөрчилнө үү!
ADMIN_PASSWORD=

# Сервер ажиллах порт
PORT=3000

# Нэг файлын дээд хэмжээ (мегабайт)
MAX_UPLOAD_MB=100

# Мэдээллийн сан, PDF, нүүр зургууд хадгалагдах хавтас
DATA_DIR=./data

# Nginx, Render зэрэг proxy-ийн ард ажиллуулж байвал 1 болгоно
TRUST_PROXY=
